{
  "schemaVersion": 1,
  "id": "xgen.login-assistant",
  "settingKey": "global:login-assistant",
  "category": "Browser",
  "domain": "Visible XGEN browser authentication",
  "enabledByDefault": true,
  "activation": {
    "role": "guard",
    "modes": ["browser-agent"],
    "intents": ["login", "sign-in", "credential", "passkey", "webauthn"],
    "signals": ["login", "log in", "sign in", "password", "passkey", "webauthn", "로그인", "암호", "비밀번호", "패스키", "접속해줘"]
  },
  "runtime": {
    "kind": "agent-browser",
    "capability": "secure-browser-authentication",
    "adapter": "agent-browser",
    "server": "xgen_browser",
    "toolProfiles": ["core", "tabs", "state"],
    "tools": ["agent_browser_tab_list", "agent_browser_open", "agent_browser_snapshot", "agent_browser_click", "agent_browser_wait_for_selector", "agent_browser_wait_for_text", "agent_browser_wait_for_load", "agent_browser_get_url", "agent_browser_get_title", "agent_browser_screenshot", "agent_browser_auth_login"]
  },
  "permissions": {
    "risk": "consequential",
    "allowActions": ["navigate", "snapshot", "wait", "read", "get", "click"],
    "confirmActions": ["interact"],
    "denyActions": ["fill", "eval", "upload", "download", "network", "state", "credential-disclosure", "secret-logging"]
  },
  "presentation": {
    "browserVisible": true
  },
  "progress": {
    "label": "Secure login",
    "detail": "Checks the session, OS-encrypted vault, native passkey prompt, and signed-in state"
  }
}

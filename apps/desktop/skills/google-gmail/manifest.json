  "category": "Built-in skills",
  "domain": "mail.google.com",
  "enabledByDefault": true,
  "activation": { "role": "supplemental", "modes": ["browser-agent"], "intents": ["read-gmail", "draft-email", "send-email"], "signals": ["gmail", "google mail", "지메일", "메일 보내", "이메일 보내"] },

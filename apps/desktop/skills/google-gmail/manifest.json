  "permissions": { "risk": "consequential", "allowActions": ["navigate", "snapshot", "read", "get", "wait", "click", "fill", "interact"], "confirmActions": ["submit", "upload", "send-message", "delete-message"], "denyActions": ["eval", "network", "state"] },

{
  "schemaVersion": 1,
  "id": "xgen.browser-navigation",
  "settingKey": "global:browser-navigation",
  "category": "Browser",
  "domain": "Visible XGEN browser",
  "enabledByDefault": true,
  "activation": {
    "role": "primary",
    "modes": ["browser-agent"],
    "intents": ["open-url", "navigate", "visit", "tab-management", "scroll", "browser-inspection"],
    "signals": ["open", "navigate", "visit", "go to", "switch tab", "scroll", "compare prices", "compare retailers", "other stores", "open and compare", "열어", "열고", "접속", "이동", "방문", "탭 전환", "스크롤", "팔고 있는지", "팔고있는지", "판매하는지 비교", "가격 비교", "혜택 비교", "다른 쇼핑몰", "여러 쇼핑몰"]
  },
  "runtime": {
    "kind": "agent-browser",
    "capability": "browser-control",
    "adapter": "agent-browser",
    "server": "xgen_browser",
    "toolProfiles": ["core", "tabs"],
    "tools": ["agent_browser_tab_list", "agent_browser_tab_switch", "agent_browser_open", "agent_browser_snapshot", "agent_browser_scroll", "agent_browser_wait_for_selector", "agent_browser_wait_for_text", "agent_browser_wait_for_load", "agent_browser_get_title", "agent_browser_get_url"]
  },
  "permissions": {
    "risk": "write",
    "allowActions": ["navigate", "snapshot", "scroll", "wait", "read", "get"],
    "confirmActions": [],
    "denyActions": ["eval", "upload", "download", "network", "state", "submit"]
  },
  "presentation": {
    "browserVisible": true
  },
  "progress": {
    "label": "Browser navigation",
    "detail": "Controls tabs and pages through agent-browser"
  }
}
